---
# Замечание: комментарии внутри YAML block scalar `>` становятся частью
# значения Checks, поэтому обоснование каждого отключения вынесено в отдельный
# YAML-комментарий перед полем (вне scalar).
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-vararg,
  -misc-include-cleaner,
  -readability-convert-member-functions-to-static,
  -readability-static-accessed-through-instance,
  -modernize-use-trailing-return-type,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|.*/)(src|tests)/.*'
FormatStyle: file
CheckOptions:
  readability-function-size.LineThreshold: 60
  readability-function-size.StatementThreshold: 30
  readability-function-size.ParameterThreshold: 5
  readability-function-size.NestingThreshold: 3
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  # Qt Test требует функций-слотов `test_*` и data-функций `*_data`; они
  # вне camelBack-конвенции по дизайну.
  readability-identifier-naming.FunctionIgnoredRegexp: '^test_.*(_data)?$'
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ConstantCase: CamelCase
  readability-identifier-naming.ConstantPrefix: 'k'
  modernize-use-nullptr.NullMacros: 'NULL'
SystemHeaders: false