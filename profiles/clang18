# Profile for Clang 18 on Linux x86_64 (Debug).
#
# This profile defines build settings for Conan. CMake still needs explicit
# CC=clang-18 CXX=clang++-18 because the Conan toolchain is loaded after
# project() via include() (see CMakeLists.txt).
#
# Usage:
#   conan install . -of build/conan --build=missing -pr:b profiles/clang18 -pr profiles/clang18

[settings]
os=Linux
arch=x86_64
build_type=Debug
compiler=clang
compiler.version=18
compiler.cppstd=20

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.system.package_manager:mode=install
tools.system.package_manager:sudo=True
# Force the Clang toolchain for every package Conan builds (llmqore, spdlog).
# Without this the profile claims clang while CMake would fall back to the
# system default (gcc), silently mixing compilers.
tools.build:compiler_executables={"c": "clang-18", "cpp": "clang++-18"}
