#!/usr/bin/env bash
# Guard: запрещает прямые пуши в main/master.
# stdin: строки "<local ref> <local sha> <remote ref> <remote sha>".
# Обход (только в исключительном случае): git push --no-verify
set -euo pipefail

blocked=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "error: прямой пуш в '$remote_ref' запрещён." >&2
      echo "       Пушьте ветку (feature/..., fix/..., chore/...) и откройте PR." >&2
      echo "       Обход (исключение): git push --no-verify" >&2
      blocked=1
      ;;
  esac
done

exit "$blocked"
